# Backend API Server
PORT=8787
DB_PATH=./data/myastro.db

# Optional: Google OAuth Sign-In (Web & Android)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional: AI Astrologer Copilot (Anthropic-compatible endpoint)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=your-api-token-here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Frontend (set as GitHub Actions Variable VITE_API_URL when deploying to GitHub Pages)
VITE_API_URL=http://localhost:8787
