# ==============================================================================
# KundliFlow Deployment & Runtime Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Build (GitHub Actions -> Settings -> Secrets and variables -> Actions)
# ------------------------------------------------------------------------------
# [Repository Variables]
# The public URL where frontend in browser connects to backend API.
# Note: GitHub Pages is HTTPS, so this should ideally be an HTTPS URL (via Cloudflare tunnel or Caddy)
VITE_API_BASE_URL=http://<YOUR_ORACLE_VM_IP>:8787
VITE_GOOGLE_CLIENT_ID=654362464468-7sdsra0madqrhmpntsamcbiuc707qccn.apps.googleusercontent.com

# [Repository Secrets]
# Google Places / Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ------------------------------------------------------------------------------
# 2. Oracle Cloud VM Deployment via SSH (GitHub Actions Secrets & Variables)
# ------------------------------------------------------------------------------
# [Repository Secrets]
# The SSH private key corresponding to the public key authorized on Oracle Cloud VM
ORACLE_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----
# Public IPv4 of your Oracle Cloud VM
ORACLE_HOST=129.xxx.xxx.xxx

# [Repository Variables]
# SSH username (default: ubuntu for Ubuntu OS, opc for Oracle Linux)
ORACLE_USER=ubuntu

# ------------------------------------------------------------------------------
# 3. Backend API Server Runtime (.env on Oracle VM or injected via Actions Secrets)
# ------------------------------------------------------------------------------
PORT=8787
JWT_SECRET=replace-with-a-secure-random-32-character-secret

# Google OAuth verification on backend
GOOGLE_CLIENT_ID=654362464468-7sdsra0madqrhmpntsamcbiuc707qccn.apps.googleusercontent.com

# DeepSeek LLM (Anthropic-compatible endpoint — recommended for AI Copilot)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-flash

# Alternative: OpenAI / Gemini via OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key
# LLM_MODEL=gpt-4o-mini
