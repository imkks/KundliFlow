# Backend API Server (Oracle Cloud VM .env — NEVER put LLM keys in GitHub Pages!)
PORT=8787
JWT_SECRET=change-this-to-a-long-random-string

# DeepSeek LLM (Anthropic-compatible endpoint — recommended)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-chat

# Alternative: DeepSeek via OpenAI-compatible endpoint (leave ANTHROPIC_* unset if using this)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_MODEL=deepseek-chat

# Optional: Google OAuth Sign-In (Web & Android)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Frontend (add as GitHub Actions Variable VITE_API_BASE_URL in repo settings)
# VITE_API_BASE_URL=http://<YOUR_ORACLE_VM_IP>:8787
